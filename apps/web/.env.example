# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys / Data API). Son datos públicos del navegador:
# la seguridad la hace la base de datos con sus políticas por fila.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Proyectos antiguos: en lugar de la anterior puedes usar
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo para las pruebas en navegador (npm run e2e) contra un Supabase con el seed:
# E2E_PASSWORD=
