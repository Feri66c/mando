{
  "name": "mando",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mando/web",
    "build": "npm run build -w @mando/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "node scripts/test-db.mjs",
    "e2e": "npm run e2e -w @mando/web",
    "db:reset": "supabase db reset",
    "db:bundle": "node scripts/build-install-sql.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "@types/pg": "^8.23.1",
    "vitest": "^5.1.1",
    "typescript": "^5",
    "@types/node": "^22.20.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
