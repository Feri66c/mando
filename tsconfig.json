{
  // Solo para las pruebas de la base de datos (tests/db). Cada app y paquete tiene su propio tsconfig.
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["tests/db/**/*.ts", "vitest.db.config.mts"]
}
